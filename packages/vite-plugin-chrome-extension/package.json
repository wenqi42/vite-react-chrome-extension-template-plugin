{
  "name": "@vite-react-chrome-extension/plugin",
  "version": "0.1.0",
  "description": "Vite plugin for building Chrome Manifest V3 extensions.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "chrome-extension-doctor": "./dist/doctor.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "import": "./dist/doctor.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@babel/parser": "^7.28.4",
    "@babel/types": "^7.28.4"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/dev.js",
    "dist/dev.js.map",
    "dist/dev.d.ts",
    "dist/content-hmr.js",
    "dist/content-hmr.js.map",
    "dist/content-hmr.d.ts",
    "dist/client.js",
    "dist/client.js.map",
    "dist/client.d.ts",
    "dist/doctor.js",
    "dist/doctor.js.map",
    "dist/doctor.d.ts",
    "dist/chrome-permission-map.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/build.js",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist/test/plugin.test.js"
  },
  "license": "MIT"
}
