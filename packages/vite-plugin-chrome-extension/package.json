{
  "name": "@vite-react-chrome-extension/plugin",
  "version": "0.1.0",
  "description": "Vite plugin for building React projects as Chrome Manifest V3 extensions.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@babel/parser": "^7.28.4",
    "@babel/types": "^7.28.4"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/chrome-permission-map.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/build.js",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist/test/*.test.js"
  },
  "license": "MIT"
}
